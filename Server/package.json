    "menus:import": "tsx Scripts/ImportMenus.ts"
  },
  "dependencies": {
    "@nutri/shared": "workspace:*",
    "hono": "^4.6.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.30",
    "@cloudflare/workers-types": "^4.20241022.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "2.0.5",
    "wrangler": "^3.84.0"
  }
}
